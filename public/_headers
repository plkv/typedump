# Read by Cloudflare Pages (and Netlify). `output: 'export'` turns the site into
# plain files, and Next's own `headers()` only runs on a Next server — so the
# font headers that used to live in next.config.mjs live here instead.

/fonts/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET
  Cache-Control: public, max-age=31536000, immutable

# Hashed build output is safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The hero reel's clips and posters. Requested as /hero/<name>.mp4?v=<n>, and
# HeroReel bumps n whenever a clip is re-rendered, so a year is safe; without a
# rule here every visit revalidated each clip before it could play.
/hero/*
  Cache-Control: public, max-age=31536000, immutable
